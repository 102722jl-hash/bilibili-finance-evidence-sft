+def load_graph(db_path: str | Path, video_id: str) -> GraphData:
+    store = Store(db_path)
+    with store._connect() as connection:
+        claim_rows = connection.execute(
+            "SELECT * FROM claims WHERE video_id = ? ORDER BY claim_id", (video_id,)
+        ).fetchall()
+        edge_rows = connection.execute(
+            """
+            SELECT e.* FROM edges e
+            JOIN claims c ON c.claim_id = e.from_claim_id
+            WHERE c.video_id = ? ORDER BY e.edge_id
+            """,
+            (video_id,),
+        ).fetchall()
+        has_sources = connection.execute(
+            "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'sources'"
+        ).fetchone()
+        source_rows = connection.execute("SELECT * FROM sources ORDER BY source_id").fetchall() if has_sources else []
+    claims = [Claim(**dict(row)) for row in claim_rows]
+    edges = []
+    for row in edge_rows:
+        data = dict(row)
+        import json
+        data["evidence_refs"] = json.loads(data["evidence_refs"])
+        edges.append(Edge(**data))
+    return GraphData(video_id=video_id, title=video_id, claims=claims, edges=edges, sources=[SourceRecord(**dict(row)) for row in source_rows])
